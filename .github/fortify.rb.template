class Fortify < Formula
  desc "Validate dbt changes against production warehouse data"
  homepage "https://embrasure.ai"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/EmbrasureAI/fortify/releases/download/v@VERSION@/fortify-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@MAC_ARM@"
    else
      url "https://github.com/EmbrasureAI/fortify/releases/download/v@VERSION@/fortify-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@MAC_INTEL@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/EmbrasureAI/fortify/releases/download/v@VERSION@/fortify-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@LINUX_ARM@"
    else
      url "https://github.com/EmbrasureAI/fortify/releases/download/v@VERSION@/fortify-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@LINUX_INTEL@"
    end
  end

  def install
    bin.install "fortify", "embrasure"
    (libexec/"fortify").install "python"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/fortify --version")
  end
end
